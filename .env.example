# Telegram
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
ADMIN_IDS=123456789
BOT_NAME=BDAKA SHOP

# PostgreSQL (Docker Compose service name: db)
POSTGRES_DB=bdaka_shop
POSTGRES_USER=bdaka
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://bdaka:GENERATE_A_LONG_RANDOM_PASSWORD@db:5432/bdaka_shop

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379/0

# Supplier API (optional until configured)
SANDROMANIA_API_KEY=
SANDROMANIA_API_SECRET=

# Crypto Pay (leave empty to disable)
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_TESTNET=true
CRYPTO_PAY_ACCEPTED_ASSETS=USDT,TON
CRYPTO_USD_RUB_RATE=0
CRYPTO_PAY_EXPIRES_IN=3600
CRYPTO_PAY_POLL_INTERVAL=15
CRYPTO_PAY_WEBHOOK_PATH=/api/payments/cryptobot/webhook

# Platega (optional)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Webhook server (enable only when reverse proxy / firewall is configured)
WEBHOOK_SERVER_ENABLED=false
PLATEGA_WEBHOOK_HOST=0.0.0.0
PLATEGA_WEBHOOK_PORT=8080

# Test-only switches: keep disabled in production
ALLOW_TEST_PAYMENTS=false
