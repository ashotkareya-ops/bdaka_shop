# Copy to .env and fill in your own credentials.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=YOUR_TELEGRAM_USER_ID
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
CURRENCY=RUB

SANDROMANIA_BASE_URL=https://api.sandromania.shop
SANDROMANIA_API_KEY=YOUR_SANDROMANIA_API_KEY
SANDROMANIA_API_SECRET=YOUR_SANDROMANIA_API_SECRET
SANDROMANIA_POLL_ATTEMPTS=8
SANDROMANIA_POLL_INTERVAL=2

PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_WEBHOOK_HOST=127.0.0.1
PLATEGA_WEBHOOK_PORT=8080
PLATEGA_WEBHOOK_PATH=/api/payments/platega/webhook
